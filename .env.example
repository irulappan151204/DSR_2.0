# ==============================================================================
# DSR Online (QMIS) - Environment Variables Template
# Copy this file to .env and replace placeholders with secure production values.
# NEVER commit the real .env file into version control!
# ==============================================================================

# Cryptographically strong secret key (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string

# Database connection URL (Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>)
# For AWS RDS MySQL / Aurora:
# 1. Create a dedicated application user with least privilege (DO NOT use root or admin master user):
#    CREATE USER 'dsr_app_user'@'%' IDENTIFIED BY 'StrongRandomPassword!';
#    GRANT SELECT, INSERT, UPDATE, DELETE ON dsr_db.* TO 'dsr_app_user'@'%';
#    FLUSH PRIVILEGES;
# 2. Use RDS endpoint hostname and enable SSL if required by RDS Parameter Group:
#    DATABASE_URL=mysql+pymysql://dsr_app_user:StrongRandomPassword!@rds-instance-name.xxxxxx.us-east-1.rds.amazonaws.com:3306/dsr_db?ssl_ca=/etc/ssl/certs/rds-combined-ca-bundle.pem
DATABASE_URL=mysql+pymysql://dsr_user:STRONG_PASSWORD_HERE@db:3306/dsr_db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Flask Environment Settings
FLASK_APP=app.py
FLASK_DEBUG=False
FLASK_ENV=production

# Session & Security Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=45
MAX_CONTENT_LENGTH=67108864
PREFERRED_URL_SCHEME=https

# Rate Limiting Configuration
RATELIMIT_DEFAULT=200 per day;50 per hour

# SocketIO Security (Set to your production domain(s), comma-separated)
# Example: https://qmis-dsr.com,https://www.qmis-dsr.com
SOCKETIO_CORS_ALLOWED_ORIGINS=https://qmis-dsr.com

# Redis & Caching Configuration
REDIS_URL=redis://redis:6379/0
CACHE_TYPE=RedisCache
CACHE_DEFAULT_TIMEOUT=300

