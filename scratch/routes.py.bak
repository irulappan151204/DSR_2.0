@app.route('/api/team2_lead/hr-attendance/<int:form_id>')
@login_required
def team2_lead_api_hr_attendance(form_id):
    team2 = Team.query.filter_by(team_name='Team 2').first()
    if not team2 or not (current_user.role == 'Team Lead' and current_user.team_id == team2.team_id):
        return jsonify({'error': 'Access Denied'}), 403

    form_data = Team2HRAttendance.query.get_or_404(form_id)
    if form_data.team_id != current_user.team_id:
         return jsonify({'error': 'Access Denied - Form belongs to another team'}), 403

    # Convert data to dict for JSON response
    data_dict = {c.name: getattr(form_data, c.name) for c in form_data.__table__.columns}
    # Format dates/times if necessary
    if isinstance(data_dict.get('submitted_at'), datetime):
        data_dict['submitted_at'] = data_dict['submitted_at'].strftime('%Y-%m-%d %H:%M:%S')

    return jsonify(data_dict)


