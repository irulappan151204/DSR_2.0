# Team 2 Lead Routes
@app.route('/team2-lead/dashboard')
@login_required
def team2_lead_dashboard():
    # Ensure the user is a Team Lead and belongs to Team 2
    # You might need a more robust way to identify Team 2, e.g., by name or a specific ID
    team2 = Team.query.filter_by(team_name='Team 2').first() # Adjust 'Team 2' if name is different
    if not team2:
        flash('Team 2 not found in the system.', 'error')
        return redirect(url_for('login')) # Or a generic dashboard

    if not (current_user.role == 'Team Lead' and current_user.team_id == team2.team_id):
        flash('Access denied. Team 2 Lead privileges required.', 'error')
        return redirect(url_for('login')) # Or a generic dashboard

    team_id = current_user.team_id
    today = datetime.now(ZoneInfo('Asia/Kolkata')).date()

    # Fetch data for the dashboard
    team_members = User.query.filter_by(team_id=team_id, role='Team Member').all()
    hr_attendance_data = Team2HRAttendance.query.filter_by(team_id=team_id).order_by(Team2HRAttendance.submitted_at.desc()).all()
    admin_attendance_data = Team2AdminAttendance.query.filter_by(team_id=team_id).order_by(Team2AdminAttendance.submitted_at.desc()).all()
    recruitment_activity_data = Team2RecruitmentActivity.query.filter_by(team_id=team_id).order_by(Team2RecruitmentActivity.submitted_at.desc()).all()
    pending_recruitment_data = Team2PendingRecruitment.query.filter_by(team_id=team_id).order_by(Team2PendingRecruitment.submitted_at.desc()).all()
    recruitment_pipeline_data = Team2RecruitmentPipeline.query.filter_by(team_id=team_id).order_by(Team2RecruitmentPipeline.submitted_at.desc()).all()
    staff_status_updates_data = Team2StaffStatusUpdates.query.filter_by(team_id=team_id).order_by(Team2StaffStatusUpdates.submitted_at.desc()).all()
    salary_pending_data = Team2SalaryPending.query.filter_by(team_id=team_id).order_by(Team2SalaryPending.submitted_at.desc()).all()
    police_verification_data = Team2PoliceVerification.query.filter_by(team_id=team_id).order_by(Team2PoliceVerification.submitted_at.desc()).all()
    interview_schedule_data = Team2InterviewSchedule.query.filter_by(team_id=team_id).order_by(Team2InterviewSchedule.submitted_at.desc()).all()
    return render_template('team2_lead_dashboard.html',
                         team_members=team_members,
                         team2_hr_attendance_data=hr_attendance_data,
                         team2_admin_attendance_data=admin_attendance_data,
                         team2_recruitment_activity_data=recruitment_activity_data,
                         team2_pending_recruitment_data=pending_recruitment_data,
                         team2_recruitment_pipeline_data=recruitment_pipeline_data, 
                         team2_staff_status_updates_data=staff_status_updates_data,
                         team2_salary_pending_data=salary_pending_data,
                         team2_police_verification_data=police_verification_data,
                         team2_interview_schedule_data=interview_schedule_data,
                         today_date=today.strftime('%Y-%m-%d')) 


# API Routes for Team 2 Lead Dashboard Modals and Status Updates
@app.route('/api/team2_lead/data')
@login_required
def team2_lead_api_data():
    team2 = Team.query.filter_by(team_name='Team 2').first()
    if not team2 or not (current_user.role == 'Team Lead' and current_user.team_id == team2.team_id):
        return jsonify({'error': 'Access Denied'}), 403

    selected_date_str = request.args.get('date', datetime.now(ZoneInfo('Asia/Kolkata')).strftime('%Y-%m-%d'))
    try:
        selected_date = datetime.strptime(selected_date_str, '%Y-%m-%d').date()
    except ValueError:
        selected_date = datetime.now(ZoneInfo('Asia/Kolkata')).date() # Default to today if date is invalid

    start_of_day = datetime.combine(selected_date, datetime.min.time(), tzinfo=ZoneInfo('Asia/Kolkata'))
    end_of_day = datetime.combine(selected_date, datetime.max.time(), tzinfo=ZoneInfo('Asia/Kolkata'))

    team_members = User.query.filter_by(team_id=current_user.team_id, role='Team Member').all()
    status_data = []

    for member in team_members:
        hr_submitted = Team2HRAttendance.query.filter(
            Team2HRAttendance.submitted_by == member.user_id,
            Team2HRAttendance.submitted_at >= start_of_day,
            Team2HRAttendance.submitted_at <= end_of_day
        ).count() > 0
        admin_submitted = Team2AdminAttendance.query.filter(
            Team2AdminAttendance.submitted_by == member.user_id,
            Team2AdminAttendance.submitted_at >= start_of_day,
            Team2AdminAttendance.submitted_at <= end_of_day
        ).count() > 0
        rec_act_submitted = Team2RecruitmentActivity.query.filter(
            Team2RecruitmentActivity.submitted_by == member.user_id,
            Team2RecruitmentActivity.submitted_at >= start_of_day,
            Team2RecruitmentActivity.submitted_at <= end_of_day
        ).count() > 0
        pending_rec_submitted = Team2PendingRecruitment.query.filter(
            Team2PendingRecruitment.submitted_by == member.user_id,
            Team2PendingRecruitment.submitted_at >= start_of_day,
            Team2PendingRecruitment.submitted_at <= end_of_day
        ).count() > 0
        rec_pipeline_submitted = Team2RecruitmentPipeline.query.filter(
            Team2RecruitmentPipeline.submitted_by == member.user_id,
            Team2RecruitmentPipeline.submitted_at >= start_of_day,
            Team2RecruitmentPipeline.submitted_at <= end_of_day
        ).count() > 0
        staff_status_submitted = Team2StaffStatusUpdates.query.filter(
            Team2StaffStatusUpdates.submitted_by == member.user_id,
            Team2StaffStatusUpdates.submitted_at >= start_of_day,
            Team2StaffStatusUpdates.submitted_at <= end_of_day
        ).count() > 0
        salary_pending_submitted = Team2SalaryPending.query.filter(
            Team2SalaryPending.submitted_by == member.user_id,
            Team2SalaryPending.submitted_at >= start_of_day,
            Team2SalaryPending.submitted_at <= end_of_day
        ).count() > 0   
        police_verification_submitted = Team2PoliceVerification.query.filter(
            Team2PoliceVerification.submitted_by == member.user_id,
            Team2PoliceVerification.submitted_at >= start_of_day,
            Team2PoliceVerification.submitted_at <= end_of_day
        ).count() > 0
        interview_schedule_submitted = Team2InterviewSchedule.query.filter(
            Team2InterviewSchedule.submitted_by == member.user_id,
            Team2InterviewSchedule.submitted_at >= start_of_day,
            Team2InterviewSchedule.submitted_at <= end_of_day
        ).count() > 0

        # Add checks for pending and pipeline if needed for status

        # Find last submission time (considering all relevant forms for Team 2)
        last_sub_time = None
        forms = [Team2HRAttendance, Team2AdminAttendance, Team2RecruitmentActivity, Team2PendingRecruitment, Team2RecruitmentPipeline, Team2StaffStatusUpdates, Team2SalaryPending, Team2PoliceVerification, Team2InterviewSchedule]
        for form_model in forms:
             last_entry = form_model.query.filter_by(submitted_by=member.user_id).order_by(form_model.submitted_at.desc()).first()
             if last_entry and (last_sub_time is None or last_entry.submitted_at > last_sub_time):
                 last_sub_time = last_entry.submitted_at

        status_data.append({
            'user_id': member.user_id,
            'username': member.username,
            'hr_attendance_submitted': hr_submitted,
            'admin_attendance_submitted': admin_submitted,
            'recruitment_activity_submitted': rec_act_submitted, # Assuming this is the main one for 'Recruitment' status badge
            'pending_recruitment_submitted': pending_rec_submitted,
            'recruitment_pipeline_submitted': rec_pipeline_submitted,
            'staff_status_updates_submitted': staff_status_submitted,
            'salary_pending_submitted': salary_pending_submitted,
            'police_verification_submitted': police_verification_submitted,
            'last_submission': last_sub_time.strftime('%Y-%m-%d %H:%M:%S') if last_sub_time else 'No submissions'
        })

    return jsonify({'team_members_status': status_data})

